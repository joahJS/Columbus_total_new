<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <!--
    ComnLib/DBConn 이 사용할 DB 연결 문자열. VisionIns 솔루션처럼 소스코드에 서버 주소/계정을
    하드코딩하지 않고 여기(배포 환경별로 교체되는 설정 파일)에만 둔다.
    실제 DB/스키마가 준비되기 전까지는 비어 있으며, DBConn을 사용하는 리포지토리가 아직 없으므로
    지금 당장 값을 채우지 않아도 프로그램 동작에는 영향이 없다.
  -->
  <connectionStrings>
    <add name="Columbus" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- 계근대 지시계 통신 포트 설정. 실제 지시계 연동 시 SerialScaleIndicatorService 에서 사용. -->
    <add key="ScalePortName" value="COM1" />
    <add key="ScaleBaudRate" value="9600" />
    <!-- true 이면 SimulatedScaleIndicatorService(모의 계량) 사용, false 이면 실제 시리얼 포트 사용 -->
    <add key="UseSimulatedScale" value="true" />
  </appSettings>
</configuration>
