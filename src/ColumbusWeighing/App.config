<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <!--
    ComnLib/DBConn 이 사용할 DB 연결 문자열. VisionIns 솔루션처럼 소스코드에 서버 주소/계정을
    하드코딩하지 않고 여기(배포 환경별로 교체되는 설정 파일)에만 둔다.
    이 프로그램은 조회/집계 전용이므로 통합 허브 DB(COLUMBUS_WEIGH_HUB, sql/COLUMBUS_WEIGH_HUB_schema.sql
    참고)만 바라보면 되며, 실제 연동 리포지토리(예: SqlWeighingRepository)가 준비되면 이 값을 채운다.
    지금 당장 값을 채우지 않아도 프로그램 동작(InMemoryWeighingRepository 사용)에는 영향이 없다.
  -->
  <connectionStrings>
    <add name="ColumbusWeighHub" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
