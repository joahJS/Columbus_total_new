<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!-- 계근대 지시계 통신 포트 설정. 실제 지시계 연동 시 SerialScaleIndicatorService 에서 사용. -->
    <add key="ScalePortName" value="COM1" />
    <add key="ScaleBaudRate" value="9600" />
    <!-- true 이면 SimulatedScaleIndicatorService(모의 계량) 사용, false 이면 실제 시리얼 포트 사용 -->
    <add key="UseSimulatedScale" value="true" />
  </appSettings>
</configuration>
