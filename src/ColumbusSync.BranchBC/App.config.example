<?xml version="1.0" encoding="utf-8"?>
<!--
  이 파일은 템플릿입니다(Git 추적 대상). 실제 App.config는 Git 추적 대상이 아니므로,
  이 파일을 같은 폴더에 "App.config"로 복사한 뒤 실제 값을 채워 넣으세요.
  App.config 자체는 .gitignore에 등록되어 있어서, 값을 채워도 커밋/푸시될 일이 없습니다.

  B지점 PC와 C지점 PC 양쪽에 이 프로그램을 각각 설치합니다. 두 PC는 코드가 완전히 동일하고,
  App.config의 BranchCode와 MdbFilePath만 다릅니다.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <connectionStrings>
    <!--
      통합 허브 DB. 서버: 소나무 개발서버 (121.66.17.30:16433) / DB: COLUMBUS_WEIGH_HUB
      동기화 전용 계정(pineit_ex, sql/COLUMBUS_WEIGH_HUB_grant_sync_account.sql로 권한 부여됨) 사용.
      비밀번호는 소스에 커밋하지 말고 배포 PC의 App.config에서만 채워 넣습니다.
    -->
    <add name="IntegrationHub"
         connectionString="Server=121.66.17.30,16433;Database=COLUMBUS_WEIGH_HUB;User Id=pineit_ex;Password=__SET_ME__;Encrypt=True;TrustServerCertificate=True;" />
  </connectionStrings>

  <appSettings>
    <!-- 이 PC가 담당하는 지점. B지점 PC에는 "B", C지점 PC에는 "C"를 넣습니다. -->
    <add key="BranchCode" value="__SET_ME__" />
    <!--
      TS2020 프로그램이 쓰는 mdb 파일의 전체 경로. TS2020이 설치된 PC에서 실제 경로를
      확인해서 채워 넣으세요(보통 TS2020 설치 폴더 밑에 있습니다). 예시:
      C:\TS2020\DB\TSDB.mdb
    -->
    <add key="MdbFilePath" value="__SET_ME__" />
    <!-- 동기화 주기(분). 기본 10분. -->
    <add key="SyncIntervalMinutes" value="10" />
    <!-- 로그 파일 저장 경로. 상대경로면 실행파일 폴더 기준. -->
    <add key="LogFilePath" value="logs\ColumbusSync.BranchBC.log" />
    <!--
      계근 데이터를 매 배치마다 다시 훑는 기간(일). 검수/수정이 이 기간보다 늦게 들어오면
      반영되지 않습니다. 실제 업무에서 수정이 며칠까지 늦어질 수 있는지에 맞춰 조정하세요.
    -->
    <add key="WeighSyncLookbackDays" value="30" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="" />
    </assemblyBinding>
  </runtime>
</configuration>
