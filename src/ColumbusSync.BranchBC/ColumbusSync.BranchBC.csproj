    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Source\Dto.cs" />
    <Compile Include="Source\MdbSourceReader.cs" />
    <Compile Include="Source\OleDbHelper.cs" />
    <Compile Include="SyncOrchestrator.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      App.config는 Git 추적 대상이 아니다(README 참고) — 빌드하려면 App.config.example을
      복사해서 App.config로 만들어야 한다. MSBuild는 실제 파일이 디스크에 있으면 되므로
      git 추적 여부와 무관하게 정상적으로 참조/복사한다.
    -->
    <None Include="App.config" />
  </ItemGroup>
