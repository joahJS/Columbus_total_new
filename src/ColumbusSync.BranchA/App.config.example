<?xml version="1.0" encoding="utf-8"?>
<!--
  이 파일은 템플릿입니다(Git 추적 대상). 실제 App.config는 Git 추적 대상이 아니므로,
  처음 받으신 분은 이 파일을 같은 폴더에 "App.config"로 복사한 뒤 실제 값을 채워 넣으세요.
  App.config 자체는 .gitignore에 등록되어 있어서, 값을 채워도 커밋/푸시될 일이 없습니다.
  이후 이 예시 파일(App.config.example)에 새 설정이 추가되면, 그 항목만 로컬 App.config에
  직접 옮겨 적으면 됩니다.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <connectionStrings>
    <!--
      A지점 원본(MES, Columbus_total 코드가 실제로 접속하는 DB).
      서버: sql16ssd-006.localnet.kr,1433 / DB: columbusdb_pineit
      실제 배포 시 서버 주소/계정 정보로 교체하세요. 비밀번호는 소스에 커밋하지 말고
      배포 PC의 App.config(또는 환경변수/자격증명 저장소)에서만 채워 넣습니다.
    -->
    <add name="BranchA_Mes"
         connectionString="Server=sql16ssd-006.localnet.kr,1433;Database=columbusdb_pineit;User Id=__SET_ME__;Password=__SET_ME__;Encrypt=True;TrustServerCertificate=True;" />

    <!--
      통합 허브 DB. 서버: 소나무 개발서버 (121.66.17.30:16433) / DB: COLUMBUS_WEIGH_HUB
      동기화 전용 계정(pineit_ex, sql/COLUMBUS_WEIGH_HUB_grant_sync_account.sql로 권한 부여됨) 사용.
      비밀번호는 소스에 커밋하지 말고 배포 PC의 App.config에서만 채워 넣습니다.
    -->
    <add name="IntegrationHub"
         connectionString="Server=121.66.17.30,16433;Database=COLUMBUS_WEIGH_HUB;User Id=pineit_ex;Password=__SET_ME__;Encrypt=True;TrustServerCertificate=True;" />
  </connectionStrings>

  <appSettings>
    <!-- 동기화 주기(분). B/C지점 mdb 복사 프로그램과 동일한 10분 주기가 기본값입니다. -->
    <add key="SyncIntervalMinutes" value="10" />
    <!-- 로그 파일 저장 경로. 상대경로면 실행파일 폴더 기준. -->
    <add key="LogFilePath" value="logs\ColumbusSync.BranchA.log" />
    <!--
      계근 데이터를 매 배치마다 다시 훑는 기간(일). 기본 1년. MEASURE_RETR은 계량일자
      (TDATE) 기준으로만 조회되고 수정일시 필터는 지원하지 않아서, 이 값과 무관하게
      매 주기 똑같이 전체 기간을 다시 받는다 - 다만 내용이 안 바뀐 완료건은
      WeighHashCache가 걸러내 허브 DB에 다시 쓰지는 않는다(원본 MES 조회 자체는
      매번 그대로 한다. 사내망이라 보통 문제 없음).
    -->
    <add key="WeighSyncLookbackDays" value="365" />
    <!--
      완료된 계근건의 내용 해시를 저장해두는 로컬 캐시 파일 경로. 상대경로면 실행파일
      폴더 기준. 이 파일이 지워지면(재배포 등) 다음 주기에 한 번 더 전체를 허브로
      업서트하게 될 뿐, 데이터가 틀어지지는 않습니다.
    -->
    <add key="WeighHashCachePath" value="state\weigh_hash_cache.tsv" />
    <!--
      계근 사진이 올라가 있는 FTP 서버 경로. Columbus_MES(SA015F00.cs)가 쓰는 것과 동일한
      서버/계정입니다(ComnLib/ComnClass.cs 참고). 비워두면 사진 동기화를 하지 않습니다.
      예: ftp://121.66.17.30:16021/Columbus/  (끝에 반드시 "/" 포함)
    -->
    <add key="FtpPath" value="" />
    <add key="FtpUserId" value="__SET_ME__" />
    <add key="FtpPassword" value="__SET_ME__" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="" />
    </assemblyBinding>
  </runtime>
</configuration>
